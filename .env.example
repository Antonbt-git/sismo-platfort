# === Base de datos ===
# PostgreSQL local o gestionado (Supabase):
#   postgresql+psycopg://usuario:clave@host:5432/postgres
DATABASE_URL=postgresql+psycopg://sismo:sismo@localhost:5432/sismodb

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=600
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# === Semilla inicial ===
SEED_ADMIN_EMAIL=admin@sismoplatform.pe
SEED_ADMIN_PASSWORD=cambiar-en-produccion

# === Ingesta ===
INGESTA_INTERVAL_SECONDS=300
INGESTA_MIN_MAGNITUDE=2.5
INGESTA_LOOKBACK_HOURS=24

# === ML y reportes ===
ARTIFACTS_DIR=var/artifacts
REPORTS_DIR=var/reports

# === Web (Vercel) ===
# En desarrollo se deja sin definir (se usa el proxy de Vite hacia /api).
# En Vercel: VITE_API_URL=https://sismo-api.onrender.com
# VITE_API_URL=
